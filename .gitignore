# =========================================================
# AlgoMultiAssetEA - Git Allowlist
# Ignore everything by default
# =========================================================

*

# ---------------------------------------------------------
# Git / project metadata
# ---------------------------------------------------------

!.gitignore
!AGENTS.md

# Never track local/editor/AI configuration
.github/
.vscode/

# =========================================================
# CASE A: Repository root = MT5 Data Folder
# =========================================================

!MQL5/
!MQL5/Experts/
!MQL5/Experts/AlgoMultiAssetEA.mq5

!MQL5/Include/
!MQL5/Include/AlgoSystem/
!MQL5/Include/AlgoSystem/**

# =========================================================
# CASE B: Repository root = MQL5 folder
# =========================================================

!Experts/
!Experts/AlgoMultiAssetEA.mq5

!Include/
!Include/AlgoSystem/
!Include/AlgoSystem/**

# Ignore all .log files
*.log
**/*.log
*.log.*


# Shared Agent Skills (Kilo + Copilot compatibility)
!.agents/
!.agents/skills/
!.agents/skills/**/
!.agents/skills/**
!.agents/skills/*

# Kilo project configuration
!kilo.jsonc

# Kilo project rules
!.kilo/
!.kilo/**
!.kilo/rules/
!.kilo/rules/mql5.md

# Kilo project agents (when present)
!.kilo/agents/
!.kilo/agents/*.md

# Build tools
!tools/
!tools/Compile-MT5.ps1
!tools/AlgoMultiAssetEA-ValidationHarness.ps1
!tools/ValidationHarness.Tests.ps1
